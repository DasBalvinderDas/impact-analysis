# Agent model and local authentication
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
ADK_MODEL=gemini-2.5-flash
ADK_LOCAL_SECRETS=1
GITHUB_TOKEN=github-pat-with-repo-issue-write-access

# GitHub MCP access
GITHUB_MCP_TRANSPORT=http
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# Search the checked-in POC architecture docs while running locally.
DOCS_SOURCE=local
ARCHITECTURE_DOCS_PATH=/absolute/path/to/impact-analysis/poc/target_app/docs

# PDF publishing
REPORTS_GCS_BUCKET=your-impact-reports-bucket
