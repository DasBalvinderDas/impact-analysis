# --- Model backend ---
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
ADK_MODEL=gemini-2.5-flash

# --- Secrets (production) ---
# GitHub PAT is read from Secret Manager ONCE AT PROCESS STARTUP
# (agent.py -> tools/github_tools.py) at
# projects/${GOOGLE_CLOUD_PROJECT}/secrets/${GITHUB_TOKEN_SECRET_ID}/versions/latest
# The process fails fast at import time if this secret isn't accessible.
# Set ADK_LOCAL_SECRETS=1 to instead read GITHUB_TOKEN below (local dev only).
GITHUB_TOKEN_SECRET_ID=git-agent-secret-key
ADK_LOCAL_SECRETS=0
GITHUB_TOKEN=

# --- GitHub MCP Server ---
# http (default) uses GitHub's hosted Copilot coding-agent MCP endpoint;
# stdio launches ghcr.io/github/github-mcp-server locally via Docker.
GITHUB_MCP_TRANSPORT=http
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# --- Documentation search ---
# "gcs" (default) or "local"
DOCS_SOURCE=gcs
ARCHITECTURE_DOCS_BUCKET=your-architecture-docs-bucket
ARCHITECTURE_DOCS_PATH=docs

# --- Report publishing ---
REPORTS_GCS_BUCKET=your-impact-reports-bucket
