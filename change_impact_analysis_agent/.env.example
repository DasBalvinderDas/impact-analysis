# --- Model backend ---
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
ADK_MODEL=gemini-2.5-flash

# --- Secrets (production) ---
# GitHub token is read from Secret Manager at
# projects/${GOOGLE_CLOUD_PROJECT}/secrets/github-token/versions/latest
# Set ADK_LOCAL_SECRETS=1 to instead read GITHUB_TOKEN below (local dev only).
ADK_LOCAL_SECRETS=0
GITHUB_TOKEN=

# --- GitHub MCP Server ---
GITHUB_MCP_TRANSPORT=http
GITHUB_MCP_URL=https://api.github.com/mcp

# --- Documentation search ---
# "gcs" (default) or "local"
DOCS_SOURCE=gcs
ARCHITECTURE_DOCS_BUCKET=your-architecture-docs-bucket
ARCHITECTURE_DOCS_PATH=docs

# --- Report publishing ---
REPORTS_GCS_BUCKET=your-impact-reports-bucket
